# Shared image version pins for local and release builds.
# Update this file when we intentionally move default toolchain or CLI versions.

NODE_MAJOR=22
GO_VERSION=1.27.0
PYTHON_VERSION=3.14t
DELTA_VERSION=0.19.2
TMUX_VERSION=3.6a
TMUX_SHA256=b6d8d9c76585db8ef5fa00d4931902fa4b8cbe8166f528f44fc403961a3f3759

CLAUDE_CODE_VERSION=2.1.258
CCTRACE_VERSION=0.46.0
CODEX_VERSION=0.152.1
GEMINI_CLI_VERSION=0.58.0
GROK_CLI_VERSION=1.0.13
KIMI_CODE_VERSION=0.39.1
OPENCODE_VERSION=1.18.26
PI_CODING_AGENT_VERSION=0.84.4
DSH_VERSION=0.1.1-rc.2
# Cursor CLI. DISABLED: empty pin = not installed, not version-tracked.
# It is the one tool with no version API -- cursor.com/install hardcodes
# the number -- so any build host that cannot reach cursor.com resolves it
# to "" and breaks the whole image build. Not worth that for one CLI.
# To re-enable, put a version back here (last known good:
# 2026.08.25-3e8eec8). The image then fetches the tarball directly from
# downloads.cursor.com/lab/<version>/linux/<arch>/agent-cli-package.tar.gz.
CURSOR_CLI_VERSION=
CCX_VERSION=v0.16.0
COPILOT_API_VERSION=0ea08febdd7e3e055b03dd298bf57e669500b5c1
PLAYWRIGHT_VERSION=1.62.1
# CloakBrowser npm wrapper version. This also pins the Chromium binary:
# the wrapper hardcodes per-arch free-binary versions (linux-x64 146.x.x.5,
# linux-arm64 146.x.x.3), so bumping the wrapper is what moves Chromium.
CLOAKBROWSER_WRAPPER_VERSION=0.5.10
# Kimi WebBridge daemon + extension. No npm package; resolved from
# cdn.kimi.com/webbridge/latest/version.json. Not consumed by any
# build yet — Dockerfile.cloak starts baking it in #543.
KIMI_WEBBRIDGE_VERSION=v1.11.6

RUST_TOOLCHAINS=stable
RUST_DEFAULT_TOOLCHAIN=stable
RUST_TARGETS=wasm32-unknown-unknown
